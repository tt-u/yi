# Built-in translation relay (optional). Copy to .env and fill in to enable the
# "Built-in (free)" option in Yi. These are baked into the renderer at build time.
# Leave empty/unset and Yi only offers the "own DeepSeek key" mode.
#
# VITE_RELAY_URL   = the deployed Cloudflare Worker URL (see worker/README.md)
# VITE_RELAY_TOKEN = the same shared secret you set as the Worker's RELAY_TOKEN
VITE_RELAY_URL=
VITE_RELAY_TOKEN=
